{
  "name": "dsh-gallery",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "产出画廊：解决 DSH 只在任务结尾才列出产出、过程不可见的问题。实时监控产出目录，图片自动刷新、文件原生预览，任务进行中即可校验纠正。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": {
    "name": "Chief (DS Bot)"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "gallery",
    "preview",
    "output-artifacts"
  ]
}