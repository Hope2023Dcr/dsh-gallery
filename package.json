{
  "name": "dsh-gallery",
  "version": "0.10.7",
  "type": "module",
  "description": "产出画廊：解决 DSH 只在任务结尾才列出产出、过程不可见的问题。实时监控产出目录，图片自动刷新、文件原生预览、音视频面板内播放（可拖进度条、可截帧），任务进行中即可校验纠正。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope2023Dcr/dsh-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/Hope2023Dcr/dsh-gallery/issues"
  },
  "homepage": "https://github.com/Hope2023Dcr/dsh-gallery#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "session-index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": {
    "name": "Hope2023Dcr"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "output-gallery",
    "image-gallery",
    "file-preview",
    "sidebar-plugin",
    "agent-tools",
    "media-gallery",
    "video-preview",
    "audio-preview"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
