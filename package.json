{
  "name": "dsh-gallery",
  "version": "0.14.4",
  "type": "module",
  "description": "产出画廊：图片 / 文件 / 音视频实时可见、当场校验；原生产出标签（素材 / 过程稿 / 定稿 / 未归类）可手动改且持久生效，改标签动作与图上圈选批注攒进反馈篮，由人审核合并后发送，全程零自动发送；视频「截取当前帧」自动存入当前对话资产，反馈能精确指到某一帧；批注框跟随图片缩放平移，标注态按住鼠标中键可平移且框不脱框。Output gallery for DeepSeek Harness: live image/file/audio/video preview, persistent manual asset labels, region annotations and label changes queued in a human-approved feedback basket, one-click video frame capture filed into the current session; region annotation boxes follow image zoom/pan, and holding the middle mouse button pans the image while annotating without losing the boxes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope2023Dcr/dsh-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/Hope2023Dcr/dsh-gallery/issues"
  },
  "homepage": "https://github.com/Hope2023Dcr/dsh-gallery#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "install.mjs",
    "index.js",
    "client.js",
    "session-index.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": {
    "name": "Hope2023Dcr"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "output-gallery",
    "image-gallery",
    "file-preview",
    "sidebar-plugin",
    "agent-tools",
    "media-gallery",
    "video-preview",
    "audio-preview",
    "range-seek",
    "filter",
    "deliverable",
    "human-in-the-loop",
    "asset-tags",
    "manual-label",
    "feedback-basket",
    "batch",
    "region-selection",
    "annotation",
    "frame-capture",
    "annotation-follow",
    "middle-mouse-pan"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
