{
  "name": "dsh-gallery",
  "version": "0.14.0",
  "type": "module",
  "description": "产出画廊：图片 / 文件 / 音视频实时可见与当场校验；按标记筛选、把「定版」真正锁住、批量处置；图上圈选批注攒成决策草稿，人工确认后送回对话。Output gallery for DeepSeek Harness: live image, file and media gallery with marker filters, persisted confirmation, batch actions, region annotation and human-approved decision drafts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope2023Dcr/dsh-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/Hope2023Dcr/dsh-gallery/issues"
  },
  "homepage": "https://github.com/Hope2023Dcr/dsh-gallery#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "session-index.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": {
    "name": "Hope2023Dcr"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "output-gallery",
    "image-gallery",
    "file-preview",
    "sidebar-plugin",
    "agent-tools",
    "media-gallery",
    "video-preview",
    "audio-preview",
    "range-seek",
    "filter",
    "deliverable",
    "confirm",
    "batch",
    "region-selection",
    "annotation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/contract/install-whitelist.test.mjs"
  }
}
